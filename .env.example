# ============================================================
# MT5 Connection — fill in your broker credentials
# ============================================================
MT5_LOGIN=your_mt5_login_here
MT5_PASSWORD=your_mt5_password_here
MT5_SERVER=your_broker_server_here
# Linux: path to terminal64.exe inside Wine prefix (auto-converted to Windows path)
MT5_PATH=/home/USERNAME/.mt5/drive_c/Program Files/MetaTrader 5/terminal64.exe

# ============================================================
# MT5 RPyC Bridge (Linux/Wine) — start before running the bot:
#   bash scripts/start_mt5_bridge.sh
# ============================================================
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=18812
MT5_BRIDGE_TIMEOUT=60

# ============================================================
# Trading mode
# WARNING: Set to true ONLY after thorough demo/backtest testing
# ============================================================
ENABLE_LIVE_TRADING=false

# ============================================================
# Risk parameters (user-configurable, never hardcoded)
# ============================================================
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=5

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================
# Online Continuous Learning & Real-Time Feedback Loop
# ============================================================
ENABLE_ONLINE_LEARNING=true
ONLINE_MEMORY_PATH=logs/online_memory.json
SYMBOL_COOLDOWN_SECONDS=1800
MIN_STOP_LOSS_PIPS=12.0
QUARANTINE_LOSS_STREAK=2
QUARANTINE_DURATION_SECONDS=14400

# ============================================================
# Optional alerting — leave blank to disable
# ============================================================
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
